# ==============================================================================
# PlaceMap Environment Configuration Template
# Duplicate this file as .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
BACKEND_PORT=8000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api/v1

# AI Orchestration & LLM Providers (Placeholders only - Do NOT commit real keys)
AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Database & Cache
DATABASE_URL=postgresql://postgres:password@localhost:5432/placemap
DIRECT_URL=
REDIS_URL=redis://localhost:6379

# Vector Database (Embeddings & Semantic Search)
VECTOR_DB_URL=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# Authentication (NextAuth / JWT)
NEXTAUTH_SECRET=your_jwt_secret_change_in_production
NEXTAUTH_URL=http://localhost:3000

# GitHub Integration (Optional - for profile and repository sync)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Logging & Observability
LOG_LEVEL=info
